# Elixpo Pay - environment variables (names only)
#
# Copy this file to .env.local and fill in your own values:
#   cp .env.example .env.local
# .env.local is git-ignored. Never commit real values, and never reuse
# production values for local development.
#
# The committed .env is SOPS-encrypted for maintainers; contributors do not
# need it and cannot decrypt it.
#
# Generate throwaway local secrets (any long random string works):
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---------------------------------------------------------------------------
# Required locally
# ---------------------------------------------------------------------------

# Public origin of this app. Defaults to http://localhost:3000 when empty.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anything other than "production". Keep this as "development" locally.
ENVIRONMENT=development

# Signs the dashboard session cookie (HMAC). Local value: openssl rand -hex 32
ELIXPO_PAY_SESSION_SECRET=

# Elixpo Accounts OAuth client used for dashboard sign-in
# (src/lib/sso.ts). Register a client with http://localhost:3000/api/auth/callback
# as the redirect URI, or ask a maintainer for a development client.
NEXT_PUBLIC_ACCOUNTS_URL=https://accounts.elixpo.com
NEXT_PUBLIC_ELIXPO_CLIENT_ID=
ELIXPO_CLIENT_SECRET=

# Email of the platform owner. The first user who signs in with this email
# claims the first-party merchant (src/lib/merchant.ts). Use your own email.
ELIXPO_PAY_OWNER_EMAIL=

# Cloudflare D1 + KV over the REST API. `next dev` has no Cloudflare bindings,
# so src/lib/d1-client.ts and src/lib/kv.ts fall back to these. Use your own
# Cloudflare account with a separate development database and KV namespace
# (`npm run db:create`, then `npm run db:migrate`), never the production ones.
# The API token needs D1 edit and Workers KV edit permissions only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_KV_NAMESPACE_ID=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------

# Razorpay. Only test mode is used locally; leave RAZORPAY_MODE as "test".
# Keys come from your own Razorpay account (Dashboard -> Test mode -> API keys).
# Without keys, checkout cannot create provider orders.
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
# Secret you choose when adding a webhook in the Razorpay test dashboard.
# Local value: openssl rand -hex 32 (and enter the same value in Razorpay).
RAZORPAY_TEST_WEBHOOK_SECRET=
# Live keys (RAZORPAY_LIVE_*) are maintainer-only and are not listed here.

# Shared secret used to sign the checkout handoff token sent to first-party
# apps (src/lib/handoff.ts). Local value: openssl rand -hex 32
ELIXPO_PAY_HANDOFF_SECRET=

# Verifies account-revoked webhooks from Elixpo Accounts
# (app/api/webhooks/account-revoked). Local value: openssl rand -hex 32
ACCOUNTS_WEBHOOK_SECRET=

# Bearer token for POST /api/cron/expire-entitlements.
# Local value: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Deploy-only (maintainers)
# ---------------------------------------------------------------------------
# Set in Cloudflare Pages / GitHub Actions secrets, not needed for local work:
#   - ENVIRONMENT and RAZORPAY_MODE for preview/production come from wrangler.toml.
#   - RAZORPAY_LIVE_KEY_ID, RAZORPAY_LIVE_KEY_SECRET, RAZORPAY_LIVE_WEBHOOK_SECRET
#   - ELIXPO_OWNER_BANK_IFSC, ELIXPO_OWNER_BANK_ACCOUNT (owner payout account)
#   - PAYOUTS_CRON_SECRET (GitHub Actions secret that feeds CRON_SECRET)
#
# Consumer-side names, not read by this app:
#   - ELIXPO_PAY_API_KEY and ELIXPO_PAY_WEBHOOK_SECRET are the names the docs
#     suggest for apps that integrate with Elixpo Pay. Per-app keys and signing
#     secrets are generated in the dashboard.
