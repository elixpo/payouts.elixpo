# Copy this file to `.env.local` and fill in the values:
#
#   cp .env.example .env.local
#
# `.env.local` is the single source of local secrets for Next.js during local development.
# `.env.local` is gitignored — never commit real secrets or credentials.
#
# The committed `.env` is SOPS-encrypted for maintainers; contributors cannot
# decrypt it and should not need to.
#
# Variables marked (required) must be set for local dashboard login and development.
# Variables marked (optional) fall back to safe defaults or disable only that specific subsystem.

# --- Elixpo Accounts SSO -----------------------------------------------------
# OAuth client registered with Elixpo Accounts (https://accounts.elixpo.com) (required for login)
NEXT_PUBLIC_ELIXPO_CLIENT_ID=
# OAuth client secret for authorization code exchange (required for login)
ELIXPO_CLIENT_SECRET=
# Elixpo Accounts host URL (optional: defaults to https://accounts.elixpo.com)
NEXT_PUBLIC_ACCOUNTS_URL=
# Secret verifying inbound account revocation webhooks from Elixpo Accounts (optional)
ACCOUNTS_WEBHOOK_SECRET=

# --- App, Sessions & Internal Secrets ---------------------------------------
# Runtime environment: "development", "local", "test", or "production" (optional: defaults to development)
ENVIRONMENT=
# Public app origin URL without trailing slash (optional: defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=
# HMAC secret signing dashboard session cookies (required: use `openssl rand -hex 32`)
ELIXPO_PAY_SESSION_SECRET=
# HMAC secret verifying checkout handoff tokens from caller applications (optional in dev)
ELIXPO_PAY_HANDOFF_SECRET=
# HMAC secret signing outbound webhook payloads sent to merchant endpoints (optional)
ELIXPO_PAY_WEBHOOK_SECRET=
# Platform API key for server-to-server endpoints (optional)
ELIXPO_PAY_API_KEY=
# Email address of the platform owner receiving platform commission splits (optional)
ELIXPO_PAY_OWNER_EMAIL=

# --- Razorpay Payments (Test Mode) -------------------------------------------
# Provider mode: "test" or "live" (optional: defaults to test)
RAZORPAY_MODE=
# Razorpay Test Key ID starting with rzp_test_ (required for local checkout testing)
RAZORPAY_TEST_KEY_ID=
# Razorpay Test Key Secret (required for local checkout testing)
RAZORPAY_TEST_KEY_SECRET=
# Razorpay webhook signing secret for verifying local payment webhooks (optional)
RAZORPAY_TEST_WEBHOOK_SECRET=
# Note: Live credentials (RAZORPAY_LIVE_KEY_ID, RAZORPAY_LIVE_KEY_SECRET, RAZORPAY_LIVE_WEBHOOK_SECRET)
# and owner bank details (ELIXPO_OWNER_BANK_ACCOUNT, ELIXPO_OWNER_BANK_IFSC) are maintainer-only.

# --- Integrations & Background Jobs (Optional) ------------------------------
# Bearer secret token protecting scheduled cron endpoints like /api/cron/expire-entitlements
CRON_SECRET=
# HMAC signing secret for buyer receipt emails dispatched via Elixpo Mails
PAY_MAILS_SIGNING_SECRET=
# Fixed USD to INR conversion rate override for international fundraiser pledges (optional)
FUNDRAISER_USD_INR_RATE=

# --- Cloudflare D1 & KV REST Fallback (Local Dev Only) ----------------------
# Local dev runs on local D1 by default (`npm run db:migrate:local`).
# If testing remote Cloudflare D1/KV outside the Cloudflare worker runtime, specify these:
# Cloudflare account ID for REST fallback access
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare API token with D1 and KV read/write permissions
CLOUDFLARE_API_TOKEN=
# Cloudflare D1 database UUID for remote D1 execution fallback
CLOUDFLARE_DATABASE_ID=
# Cloudflare KV namespace ID for remote KV cache fallback
CLOUDFLARE_KV_NAMESPACE_ID=

# Deploy-only secrets (e.g. CI Cloudflare Pages deployment credentials)
# are managed by maintainers in CI repository secrets and are intentionally not listed here.
